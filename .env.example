# Application
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Database (docker-compose default for local: postgres://wp:wp@localhost:5432/wp)
DATABASE_URL=postgres://wp:wp@localhost:5432/wp

# Session / token signing secret — REQUIRED in production, never commit the real value
SESSION_SECRET=change-me-to-a-long-random-string

# WebSocket sync server
WS_PORT=3001

# Optional: public base URL of the sync-server host when it serves video bytes
# from a different origin than the WebSocket (split deployments). Leave empty
# to reuse NEXT_PUBLIC_WS_URL's origin — the sync server serves /stream/... .
PUBLIC_STREAM_BASE=

# Set by scripts/sync-host.sh automatically (the tunnel URL). When present the
# sync server publishes itself to the settings table so the Vercel app finds it
# at runtime instead of needing a rebuild.
PUBLIC_WS_URL=

# Rooms expire after this many hours
ROOM_TTL_HOURS=168

# Stream access token lifetime in hours
STREAM_TOKEN_TTL_HOURS=12

# Telegram MTProto (streaming). Get api_id/api_hash at https://my.telegram.org
# TELEGRAM_SESSION is generated by `npm run telegram:login`. Keep all three server-side only.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# Telegram channel to import videos from (scripts/import-telegram.ts)
TELEGRAM_IMPORT_CHANNEL=
